# Open Data Hub Tourism API base URL
OFM_TOURISM_BASE_URL=https://tourism.api.opendatahub.com

# Human-readable region name. Injected into the MCP server's LLM-facing
# instructions so the model knows what geography the tools cover. Change this
# if you point OFM_TOURISM_BASE_URL at a non-South-Tyrol Open Data Hub instance.
OFM_REGION_NAME=South Tyrol

# Default language for returned content (de, it, en, nl, cs, pl, fr, ru)
OFM_DEFAULT_LANGUAGE=en

# Streamable-HTTP transport bind address
MCP_HOST=0.0.0.0
MCP_PORT=8750

# Path the streamable-HTTP endpoint is mounted on
MCP_PATH=/mcp
